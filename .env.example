# ======================================================================
# Plantilla de variables de entorno - REDYTELCA
# ======================================================================
# Este archivo contiene los valores de ejemplo para el entorno local (XAMPP).
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env".
# 2. Ajusta los valores según tu entorno local.
# ======================================================================

DB_HOST=localhost
DB_NAME=bd_redytelca
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ======================================================================
# NOTAS IMPORTANTES:
# - El archivo .env NO se versiona (ya está excluido en .gitignore).
# - En producción (ej. cPanel), las variables se configuran directamente
# en el panel de control del servidor. Las variables del entorno del
# sistema tienen prioridad y no serán sobrescritas por el archivo .env.
# ======================================================================