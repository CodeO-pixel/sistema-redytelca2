    {
        return Validator::make($datos)
            ->required('cliente_id', 'cliente')
            ->int('cliente_id', 1)
            ->string('password_nueva', 8, 255)
            ->validateOrFail();
    }

    /**
     * Valida los datos del toggle de estado.
     *
     * @param array $datos
     * @return array
