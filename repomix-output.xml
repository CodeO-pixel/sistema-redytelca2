    {
        $sql = "SELECT * FROM {$this->table} WHERE direccion_mac = ? LIMIT 1";
        $stmt = $this->prepareAndExecute($sql, [$mac]);
        $result = $stmt->fetch(\PDO::FETCH_ASSOC);

        return $result ?: null;
    }

    /**
     * Busca un equipo por su número de serie.
