// js/portal/controllers/AuthController.js
// Orquesta login, logout, restore y cambio de contraseña del portal.
// Usa ApiClient (reuso de js/core/ApiClient.js) y PortalSession
// (fork con clave propia).
//
// 086d (2026-11-02): añadido hook `__onPortalLoginSuccess` para arrancar
// el polling de notificaciones tras un login fresco. `_clearSession()`
// ahora detiene el polling y limpia el modelo de notificaciones al
// logout o al fallo de restore.
//
// FIX 4BUGS (2026-11-02):
//   - P3: `_clearSession()` ya NO detiene el polling ni resetea el
//     modelo manualmente. Esa limpieza vive en `PortalSession.onClear`,
//     registrado en `js/portal/main.js`. Ventaja: cubre TODAS las vías
//     de pérdida de sesión (logout, restore fallido y 401 de `ApiClient`),
//     no solo las que pasan por este controller.
(function () {
    'use strict';

    function _setSession(raw) {
        var canonical = {
            authenticated: true,
            cliente: raw.cliente || null,
            token: raw.token || '',
            must_change_password: !!raw.must_change_password
        };
        if (window.PortalSession) window.PortalSession.set(canonical);
        window.permissionContext = canonical;
    }

    function _clearSession() {
        if (window.PortalSession) window.PortalSession.clear();
    }

    function _showLogin() {
        if (window.PortalAuthView) window.PortalAuthView.showLogin();
    }

    function _showApp() {
        if (window.PortalAuthView) window.PortalAuthView.showApp();
    }

    function _hideLogin() {
        if (window.PortalAuthView) window.PortalAuthView.hideLogin();
    }

    function _handleMustChangePassword(session) {
        if (session && session.must_change_password) {
            if (window.PortalAuthView) {
                window.PortalAuthView.togglePasswordModal(true, true);
            }
            return true;
        }
        return false;
    }

    async function login(username, password) {
        var btn = document.getElementById('portal-login-button');
        if (btn && btn.disabled) return;

        var feedback = document.getElementById('portal-login-feedback');
        if (feedback) feedback.textContent = '';

        if (!username || !password) {
            if (feedback) feedback.textContent = 'Ingresa usuario y contraseña.';
            return;
        }

        if (btn) { btn.disabled = true; btn.textContent = 'Ingresando…'; }

        try {
            var data = await window.ApiClient.post('api_portal_login.php', {
                username: username,
                password: password
            });

            if (data.status === 'success') {
                _setSession(data);
                _hideLogin();
                _showApp();

                if (window.PortalRouter) window.PortalRouter.renderMenu();

                var nameEl = document.getElementById('portal-profile-name');
                if (nameEl && data.cliente) {
                    nameEl.textContent = (data.cliente.nombre || '') + ' ' + (data.cliente.apellido || '') || data.cliente.username || 'Cliente';
                }

                if (_handleMustChangePassword(data)) {
                    return;
                }

                if (typeof window.__onPortalLoginSuccess === 'function') {
                    window.__onPortalLoginSuccess();
                }

                if (window.PortalRouter) {
                    var registered = window.PortalRouter.listRegistered();
                    if (registered.length > 0) {
                        window.PortalRouter.showPage(registered[0]);
                    }
                }
            } else {
                if (feedback) feedback.textContent = data.message || 'Usuario o contraseña incorrectos.';
            }
        } catch (e) {
            if (feedback) feedback.textContent = e.message || 'Error de conexión. Intenta de nuevo.';
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = 'Ingresar'; }
        }
    }

    async function logout() {
        try { await window.ApiClient.post('api_portal_logout.php', {}); } catch (e) { /* no-op */ }
        _clearSession();
        if (window.PortalRouter) window.PortalRouter.renderMenu();
        _showLogin();
        var userEl = document.getElementById('portal-username');
        var passEl = document.getElementById('portal-password');
        if (userEl) userEl.value = '';
        if (passEl) passEl.value = '';
    }

    async function restoreSession() {
        var stored = window.PortalSession ? window.PortalSession.get() : null;
        if (!stored || !stored.token) {
            _clearSession();
            return false;
        }

        try {
            var data = await window.ApiClient.get('api_portal_auth_state.php');
            if (data.status === 'success' && data.authenticated) {
                _setSession(data);
                _hideLogin();
                _showApp();

                if (window.PortalRouter) window.PortalRouter.renderMenu();

                var nameEl = document.getElementById('portal-profile-name');
                if (nameEl && data.cliente) {
                    nameEl.textContent = (data.cliente.nombre || '') + ' ' + (data.cliente.apellido || '') || data.cliente.username || 'Cliente';
                }

                if (_handleMustChangePassword(data)) {
                    return true;
                }

                if (window.PortalRouter) {
                    var registered = window.PortalRouter.listRegistered();
                    if (registered.length > 0) {
                        window.PortalRouter.showPage(registered[0]);
                    }
                }
                return true;
            } else {
                _clearSession();
                return false;
            }
        } catch (e) {
            _clearSession();
            return false;
        }
    }

    async function changePassword(currentPassword, newPassword, confirmPassword) {
        var feedback = document.getElementById('portal-password-feedback');
        var btn = document.getElementById('portal-password-submit');
        var originalText = btn ? btn.textContent : 'Actualizar contraseña';

        if (feedback) feedback.textContent = '';

        if (!currentPassword) {
            if (feedback) feedback.textContent = 'La contraseña actual es obligatoria.';
            return;
        }
        if (!newPassword || newPassword.length < 8) {
            if (feedback) feedback.textContent = 'La nueva contraseña debe tener al menos 8 caracteres.';
            return;
        }
        if (newPassword !== confirmPassword) {
            if (feedback) feedback.textContent = 'La confirmación no coincide con la nueva contraseña.';
            return;
        }
        if (newPassword === currentPassword) {
            if (feedback) feedback.textContent = 'La nueva contraseña debe ser distinta a la actual.';
            return;
        }

        if (btn) { btn.disabled = true; btn.textContent = 'Actualizando…'; }

        try {
            var res = await window.ApiClient.post('api_portal_cambiar_password.php', {
                password_actual: currentPassword,
                password_nueva: newPassword
            });

            if (res.status === 'success') {
                if (window.Toast) {
                    window.Toast.success('Contraseña actualizada. Inicia sesión con la nueva contraseña.');
                }
                _clearSession();
                if (window.PortalAuthView) window.PortalAuthView.togglePasswordModal(false, false);
                _showLogin();
                var currentEl = document.getElementById('portal-password-current');
                var newEl = document.getElementById('portal-password-new');
                var confirmEl = document.getElementById('portal-password-confirm');
                if (currentEl) currentEl.value = '';
                if (newEl) newEl.value = '';
                if (confirmEl) confirmEl.value = '';
            } else {
                if (feedback) feedback.textContent = res.message || 'Error al cambiar la contraseña.';
            }
        } catch (e) {
            if (feedback) feedback.textContent = e.message || 'Error al cambiar la contraseña.';
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = originalText; }
        }
    }

    window.PortalAuthController = {
        login: login,
        logout: logout,
        restoreSession: restoreSession,
        changePassword: changePassword
    };
})();
</file>

<file path="public/js/portal/controllers/FacturaController.js">
// js/portal/controllers/FacturaController.js
// Controller del portal para "Mis facturas" (096b, read-only).
// - load(page): lee filtros actuales, llama al modelo con paginación
//   server-side y renderiza.
// - renderPage(page): delega en la vista.
// - applyFilters(): recarga desde la página 1 con los filtros actuales.
// - clearFilters(): limpia los filtros y recarga.
// - showDetail(id): pide el detalle al backend y abre el modal.
// - Persiste filtros y página en sessionStorage (clave propia del portal).
(function () {
    'use strict';

    window.PortalFacturaController = {
        init: function () {
            if (window.PortalFacturaView) {
                window.PortalFacturaView._attachListeners();
            }
            this._restore();
        },

        load: async function (page = 1) {
            const filtros = this._readFilters();

            const btn = document.querySelector('[data-toolbar="portal-facturas"] [data-action="apply-filters"]');
            const originalText = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Cargando…'; }

            try {
                const res = await window.PortalFacturaModel.load(page, 20, filtros);
                if (res.status !== 'success') {
                    if (window.Toast) window.Toast.error(res.message || 'Error al cargar tus facturas');
                    return;
                }

                const facturas = res.facturas || [];
                const safePage = res.page || 1;
                const totalPages = res.pages || 1;
                const total = res.total || 0;

                this._persist(filtros, safePage);

                window.PortalFacturaView.renderTable(facturas, filtros.periodo);
                window.PortalFacturaView.renderPagination(safePage, totalPages);
                window.PortalFacturaView.updateCounter(total, safePage, 20);
            } catch (e) {
                if (window.Toast) window.Toast.error(e.message || 'Error al cargar tus facturas');
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = originalText; }
            }
        },

        applyFilters: function () {
            this.load(1);
        },

        clearFilters: function () {
            const estado = document.getElementById('portal-facturas-estado');
            const periodo = document.getElementById('portal-facturas-periodo');
            if (estado) estado.value = '';
            if (periodo) periodo.value = '';
            this.load(1);
        },

        showDetail: async function (id) {
            if (!id) return;

            // Si la factura ya está en cache, mostrar de inmediato
            // con esos datos. Enriquecer con el detalle del backend
            // si hace falta (no bloquea la apertura del modal).
            const cached = window.PortalFacturaModel.getById(id);
            if (cached) {
                window.PortalFacturaView.renderDetailModal(cached, []);
            }

            try {
                const detalle = await window.PortalFacturaModel.loadDetail(id);
                if (detalle) {
                    window.PortalFacturaView.renderDetailModal(detalle.factura, detalle.lineas);
                } else if (!cached) {
                    if (window.Toast) window.Toast.error('Factura no encontrada');
                }
            } catch (e) {
                if (!cached && window.Toast) {
                    window.Toast.error(e.message || 'Error al cargar el detalle');
                }
            }
        },

        _readFilters: function () {
            const estado = document.getElementById('portal-facturas-estado');
            const periodo = document.getElementById('portal-facturas-periodo');
            return {
                estado: estado ? estado.value : '',
                periodo: periodo ? String(periodo.value || '').trim() : ''
            };
        },

        _persist: function (filtros, page) {
            try {
                sessionStorage.setItem('redytelca.portal.facturas.estado', filtros.estado || '');
                sessionStorage.setItem('redytelca.portal.facturas.periodo', filtros.periodo || '');
                sessionStorage.setItem('redytelca.portal.facturas.page', String(page || 1));
            } catch (e) { /* no-op */ }
        },

        _restore: function () {
            try {
                const estado = sessionStorage.getItem('redytelca.portal.facturas.estado');
                const periodo = sessionStorage.getItem('redytelca.portal.facturas.periodo');
                const page = sessionStorage.getItem('redytelca.portal.facturas.page');

                const elEstado = document.getElementById('portal-facturas-estado');
                const elPeriodo = document.getElementById('portal-facturas-periodo');
                if (elEstado && estado) elEstado.value = estado;
                if (elPeriodo && periodo) elPeriodo.value = periodo;

                if (page) {
                    // La página se usa en el primer load()
                    window.__portalFacturaCurrentPage = parseInt(page, 10) || 1;
                }
            } catch (e) { /* no-op */ }
        }
    };

    document.addEventListener('DOMContentLoaded', () => window.PortalFacturaController.init());
})();
</file>

<file path="public/js/portal/controllers/NotificacionController.js">
// js/portal/controllers/NotificacionController.js
// Controller del portal para notificaciones del cliente (086d).
//
// Orquesta:
//   - PortalNotificacionModel (datos)
//   - PortalNotificacionView (render)
//   - PortalRouter (navegación)
//
// Polling cada 30s con countOnly(). Fetch inicial inmediato.
// Mismo patrón que NotificacionController del staff (086c).
//
// Patrón Sonar: campana con badge, dropdown con lista, click en item
// marca como leída + navega a url_destino. Digitel/Inter (Venezuela):
// buzón de notificaciones en el portal de autogestión.
//
// 086d-fix (2026-11-02): se añade `DOMContentLoaded → init()` al final.
// Sin esto, `_attachListeners()` nunca se ejecutaba y el click en la
// campana no abría el dropdown. El badge sí aparecía porque el polling
// lo arranca `main.js` vía `__onPortalLoginSuccess`, pero el listener
// del click no se ataba. Bug encontrado en la prueba de browser.
//
// FIX 4BUGS (2026-11-02):
//   - P2: eliminado el método `loadPage()` y todas sus referencias.
//     El botón "Ver todas las notificaciones" del dropdown se eliminó
//     del HTML (`portal_cliente.php`) y su listener de la View
//     (`NotificacionView.js`). El buzón del portal es el dropdown de
//     la campana; no existe `portal-notificaciones` como página. Patrón
//     Inter/Digitel (Venezuela) y Sonar (buzón único, sin página
//     dedicada).
//   - P3: la limpieza al perder sesión (stop polling, reset modelo,
//     badge 0, cerrar dropdown) ya NO vive en `_clearSession` del
//     `AuthController` ni aquí. Vive en `PortalSession.onClear`,
//     registrado en `js/portal/main.js`. Cubre logout, restore fallido
//     y el 401 de `ApiClient`, que no pasa por ningún controller.
(function () {
    'use strict';

    window.PortalNotificacionController = {
        _pollTimer: null,
        _pollMs: 30000,
        _loading: false,

        init: function () {
            if (window.PortalNotificacionView) {
                window.PortalNotificacionView._attachListeners();
            }
            // NO startPolling aquí. Se arranca vía startPolling() desde
            // PortalAuthController/__onPortalLoginSuccess después del
            // login/restore, cuando ya hay sesión. Si se arranca en
            // DOMContentLoaded sin token, _pollOnce retorna temprano y
            // el badge queda vacío hasta 30s.
        },

        /**
         * Arranca el polling. Hace un fetch inicial inmediato para que el
         * badge aparezca en ≤2s, no en 30s.
         */
        startPolling: function () {
            this.stopPolling();
            this._pollOnce();
            this._pollTimer = setInterval(() => {
                this._pollOnce();
            }, this._pollMs);
        },

        stopPolling: function () {
            if (this._pollTimer) {
                clearInterval(this._pollTimer);
                this._pollTimer = null;
            }
        },

        /**
         * Un tick de polling. Solo actualiza el badge.
         * Silencioso si falla (no interrumpe al usuario).
         */
        _pollOnce: async function () {
            if (!window.PortalSession || !window.PortalSession.getToken()) return;
            try {
                const res = await window.PortalNotificacionModel.countOnly();
                if (res.status === 'success') {
                    window.PortalNotificacionView.renderBadge(res.no_leidas || 0);
                }
            } catch (e) {
                // Silencioso.
            }
        },

        /**
         * Abre/cierra el dropdown. Si abre, carga las últimas 20.
         */
        toggleDropdown: async function () {
            const dd = document.getElementById('portal-notif-dropdown');
            if (!dd) return;
            const isOpen = dd.style.display === 'block';
            if (isOpen) {
                window.PortalNotificacionView.toggleDropdown(false);
                return;
            }
            try {
                const res = await window.PortalNotificacionModel.load({ page: 1, per_page: 20 });
                if (res.status === 'success') {
                    window.PortalNotificacionView.renderDropdown(
                        window.PortalNotificacionModel.cache
                    );
                    window.PortalNotificacionView.renderBadge(res.no_leidas || 0);
                    window.PortalNotificacionView.toggleDropdown(true);
                }
            } catch (e) {
                if (window.Toast) window.Toast.error(e.message || 'Error al cargar notificaciones');
            }
        },

        /**
         * Marca una notificación como leída y navega a url_destino.
         * Si no hay url_destino, abre el modal de detalle.
         *
         * @param {number|string} id
         * @param {string} url
         */
        markRead: async function (id, url) {
            if (!id) return;

            try {
                await window.PortalNotificacionModel.markRead(id);
            } catch (e) {
                if (window.Toast) window.Toast.error(e.message || 'Error al marcar como leída');
                return;
            }

            // Actualizar cache local
            const notif = window.PortalNotificacionModel.getById(id);
            if (notif) {
                notif.leida_en = notif.leida_en || new Date().toISOString().slice(0, 19).replace('T', ' ');
            }

            // Decrementar badge
            if (window.PortalNotificacionModel.lastCount > 0) {
                window.PortalNotificacionModel.lastCount =
                    Math.max(0, window.PortalNotificacionModel.lastCount - 1);
            }
            window.PortalNotificacionView.renderBadge(window.PortalNotificacionModel.lastCount);
            window.PortalNotificacionView.toggleDropdown(false);

            if (url) {
                this.navigateTo(url);
            } else if (notif) {
                window.PortalNotificacionView.renderDetailModal(notif);
            }
        },

        /**
         * Marca todas las notificaciones como leídas.
         */
        markAllRead: async function () {
            try {
                const res = await window.PortalNotificacionModel.markAllRead();
                if (res.status !== 'success') {
                    if (window.Toast) window.Toast.error(res.message || 'Error al marcar todas como leídas');
                    return;
                }
                if (window.Toast) window.Toast.success(res.message || 'Notificaciones marcadas como leídas');
                window.PortalNotificacionModel.lastCount = 0;
                window.PortalNotificacionView.renderBadge(0);

                // Si el dropdown está abierto, recargar la lista
                const dd = document.getElementById('portal-notif-dropdown');
                if (dd && dd.style.display === 'block') {
                    const r = await window.PortalNotificacionModel.load({ page: 1, per_page: 20 });
                    if (r.status === 'success') {
                        window.PortalNotificacionView.renderDropdown(
                            window.PortalNotificacionModel.cache
                        );
                    }
                }
            } catch (e) {
                if (window.Toast) window.Toast.error(e.message || 'Error al marcar todas como leídas');
            }
        },

        /**
         * Navega a la url_destino devuelta por el backend.
         *
         * El backend del portal devuelve rutas como:
         *   - /portal/tickets?id=N
         *   - /portal/pagos?id=N
         *   - /portal/facturas?id=N
         *
         * Se parsea la ruta y se navega a la página correspondiente.
         * Si hay id, se abre el detalle.
         *
         * @param {string} url
         */
        navigateTo: function (url) {
            if (!url || !window.PortalRouter) {
                if (window.PortalRouter) window.PortalRouter.showPage('portal-tickets');
                return;
            }

            const m = String(url).match(/^\/portal\/([a-z_-]+)(?:\?id=(\d+))?$/);
            if (!m) {
                window.PortalRouter.showPage('portal-tickets');
                return;
            }

            const page = 'portal-' + m[1];
            const id = m[2] ? parseInt(m[2], 10) : null;

            const registered = window.PortalRouter.listRegistered();
            if (registered.indexOf(page) === -1) {
                window.PortalRouter.showPage('portal-tickets');
                return;
            }

            window.PortalRouter.showPage(page);

            if (!id) return;

            // Abrir el detalle según el módulo
            setTimeout(function () {
                if (page === 'portal-tickets' && window.PortalTicketController) {
                    window.PortalTicketController.showDetail(id);
                } else if (page === 'portal-pagos' && window.PortalPagoController) {
                    window.PortalPagoController.showDetail(id);
                } else if (page === 'portal-facturas' && window.PortalFacturaController) {
                    window.PortalFacturaController.showDetail(id);
                }
            }, 350);
        }
    };

    // 086d-fix: `init()` se llama en DOMContentLoaded. Sin esto, los
    // listeners de la campana y el dropdown nunca se ataban y el click
    // no hacía nada. Mismo patrón que el controller del admin (086c).
    document.addEventListener('DOMContentLoaded', function () {
        if (window.PortalNotificacionController) {
            window.PortalNotificacionController.init();
        }
    });
})();
