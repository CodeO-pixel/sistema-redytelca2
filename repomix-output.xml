        return $result ?: null;
    }

    /**
     * Obtiene los equipos asociados a una NAP.
     *
     * @param int $napId
     * @return array
     */
    public function findByNapId(int $napId): array
    {
        $sql = "SELECT * FROM {$this->table} WHERE nap_id = ?";
