/* ============================================================
   086d — CAMPANA DE NOTIFICACIONES (portal cliente)
   Patrón Splynx / Sonar / SmartOLT: campana en topbar,
   badge de no leídas, dropdown con últimas 20, item no leído
   con fondo tenue, click marca leída y navega.
   ============================================================ */
.portal-notif-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.portal-notif-bell {
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--surface-2);
    color: var(--text);
