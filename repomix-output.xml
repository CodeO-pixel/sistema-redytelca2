.portal-main.expanded { margin-left: 0; }

/* ============================================================
   TOPBAR
   ============================================================ */
.portal-topbar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
