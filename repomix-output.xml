    SET msg = CONCAT('Transicion no permitida en servicios: ', OLD.estado_comercial, ' -> ', NEW.estado_comercial);
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = msg;
  END IF;
END */;;
