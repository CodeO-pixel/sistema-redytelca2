    border-top: 1px solid var(--border);
    text-align: center;
}

.portal-notif-link {
    width: auto;
    padding: 4px 8px;
    background: transparent;
    color: var(--accent);
    border: none;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    font-family: inherit;
}

.portal-notif-link:hover { text-decoration: underline; }

/* ============================================================
   PORTAL-NOTIF-PAGE — Tabla del buzón completo
   Reutiliza `.portal-table` como base. Solo se ajustan:
   - Padding de la celda de estado (para que el badge no toque bordes).
   - Ancho de la columna de fecha (para que quepa "YYYY-MM-DD HH:MM").
   - Alineación del texto en celdas de fecha y estado.
   - Hover y selected-row ya vienen de `.portal-table`.
   ============================================================ */
.portal-notif-table th:first-child,
.portal-notif-table td:first-child {
    text-align: center;
    padding-left: 6px;
    padding-right: 6px;
}

.portal-notif-table td:first-child .portal-status {
    font-size: 0.72rem;
    padding: 3px 7px;
    white-space: nowrap;
}

.portal-notif-table td:nth-child(5) {
    white-space: nowrap;
    font-size: 0.82rem;
    color: var(--muted);
}

.portal-notif-table td:nth-child(4) {
    white-space: nowrap;
    font-size: 0.82rem;
}

.portal-notif-table td:nth-child(3) {
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.4;
    max-width: 400px;
}

.portal-notif-table td:nth-child(6) {
    white-space: nowrap;
    text-align: right;
}

.portal-notif-table tbody tr:hover {
    background: #f1f5f9;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 768px) {
    .portal-sidebar { width: 220px; }
    .portal-main { margin-left: 0; padding: 16px; }
    .portal-topbar { flex-direction: column; align-items: flex-start; }
    .portal-topbar-right { width: 100%; justify-content: flex-end; }
    .portal-login-card { padding: 22px; }
    .portal-detail-grid { grid-template-columns: 1fr; }
    .portal-form-grid-2 { grid-template-columns: 1fr; }

    /* 086d: dropdown de notificaciones a ancho completo en móvil */
    .portal-notif-dropdown {
        width: calc(100vw - 32px);
        right: -8px;
    }

    /* PORTAL-NOTIF-PAGE: tabla scrollable horizontalmente en móvil.
       .portal-table-wrap ya tiene overflow-x: auto; el table-layout
       fixed hace que las columnas se aplasten. Forzamos min-width
       para que el usuario pueda hacer scroll horizontal en vez de
       ver columnas de 40px. */
    .portal-notif-table {
        min-width: 720px;
    }
}
