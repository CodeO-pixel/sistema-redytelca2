        $stmt = $this->prepareAndExecute($sql, [$tecnicoId]);
        return $stmt->fetchAll(\PDO::FETCH_ASSOC);
    }

    /**
     * Obtiene las asignaciones filtradas por estado.
     *
     * @param string $estado
     * @return array
     */
