.portal-modal-form { display: grid; gap: 12px; }

.portal-modal-feedback {
    min-height: 18px; font-size: 0.83rem;
    color: var(--danger); font-weight: 500;
}

.portal-modal-actions {
    display: flex; justify-content: flex-end; gap: 10px;
