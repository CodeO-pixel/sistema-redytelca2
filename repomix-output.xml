    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.portal-notif-dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.9rem;
}

.portal-notif-dropdown-list {
    flex: 1;
    overflow-y: auto;
    max-height: 360px;
}

.portal-notif-empty {
    padding: 24px;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
}

.portal-notif-item {
    display: flex;
    width: 100%;
    padding: 10px 16px;
    background: var(--surface-2);
    border: none;
    border-bottom: 1px solid #f1f5f9;
    text-align: left;
    cursor: pointer;
    gap: 10px;
    font-family: inherit;
}

.portal-notif-item:hover { background: var(--surface); }

.portal-notif-unread { background: #eff6ff; }
.portal-notif-unread:hover { background: #dbeafe; }

.portal-notif-item-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
    line-height: 1.2;
}

.portal-notif-item-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
}

.portal-notif-item-title {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.portal-notif-item-msg {
    font-size: 0.8rem;
    color: var(--muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
}

.portal-notif-item-date {
    font-size: 0.72rem;
    color: #94a3b8;
