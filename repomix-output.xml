/* portal.css — Portal de Cliente (096a, 2026-11-01).
   096e (2026-11-01): tabla de servicios, badges, paginación, detalle.
   096b (2026-11-01): tabla de facturas, filtros, modal de detalle.
   096c (2026-11-01): tabla de pagos, form de creación, file upload,
   preview de comprobante, badge de estado de pago.
   086d (2026-11-02): campana de notificaciones, badge de no leídas,
   dropdown con últimas 20, estado vacío, item no leído.
   PORTAL-NOTIF-PAGE (2026-11-02): tabla del buzón completo
   (`#portal-notificaciones`), filtros, paginación, columna de estado.
   La tabla reutiliza `.portal-table` como base; sólo se añaden ajustes
   de ancho de columnas y padding de la celda de estado.
   CSS propio del portal. No depende del CSS del admin. El branding
   se inyecta vía branding.css.php (render-blocking). */

:root {
    --primary: #0f172a;
    --accent: #104aa8;
    --accent-rgb: 16, 74, 168;
    --bg: #eef4ff;
    --surface: #f8fafc;
    --surface-2: #ffffff;
    --text: #0f172a;
    --muted: #64748b;
    --border: #dbe3f0;
    --success: #16a34a;
    --warning: #f59e0b;
    --danger: #dc2626;
}

* { box-sizing: border-box; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    display: flex;
    min-height: 100vh;
}

/* ============================================================
   LOGIN OVERLAY
   ============================================================ */
.portal-login-overlay {
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg, #eef4ff 0%, #f8fafc 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 2000;
}

.portal-login-card {
    width: min(420px, 100%);
    background: var(--surface-2);
    border-radius: 18px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
    border: 1px solid var(--border);
}

.portal-login-brand { display: flex; justify-content: center; margin-bottom: 12px; }

.portal-login-logo {
    width: auto; max-width: 280px; max-height: 90px; min-height: 60px;
    object-fit: contain;
}

.portal-login-title {
    margin: 0 0 4px; font-size: 1.3rem;
    text-align: center; color: var(--primary);
}

.portal-login-subtitle {
    margin: 0 0 20px; text-align: center;
    color: var(--muted); font-size: 0.9rem;
}

.portal-login-form { display: grid; gap: 14px; }

.portal-field { display: grid; gap: 6px; }

.portal-field label {
    font-size: 0.85rem; font-weight: 600; color: var(--text);
}

.portal-field input,
.portal-field select,
.portal-field textarea {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.95rem;
    background: var(--surface-2);
    color: var(--text);
}

.portal-field input:focus,
.portal-field select:focus,
.portal-field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
}

.portal-field-help { font-size: 0.78rem; color: var(--muted); }

.portal-required { color: var(--danger); font-weight: 700; }

.portal-form-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.portal-login-feedback {
    min-height: 20px; font-size: 0.85rem;
    color: var(--danger); font-weight: 500;
}

.portal-login-help {
    margin: 16px 0 0; text-align: center;
    font-size: 0.8rem; color: var(--muted);
}

/* ============================================================
   BOTONES
   ============================================================ */
.portal-btn-primary,
.portal-btn-secondary {
    padding: 11px 16px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s ease;
}

.portal-btn-primary { background: var(--accent); color: #fff; }
.portal-btn-primary:hover { opacity: 0.9; }
.portal-btn-primary:disabled { opacity: 0.55; cursor: not-allowed; }

.portal-btn-secondary { background: #e2e8f0; color: var(--text); }
.portal-btn-secondary:hover { background: #cbd5e1; }

.portal-btn-danger {
    background: var(--danger); color: #fff;
    padding: 11px 16px; border-radius: 10px;
    font-weight: 600; cursor: pointer; border: none;
}
.portal-btn-danger:hover { opacity: 0.9; }

/* ============================================================
