     */
    public function countByServicioId(int $servicioId): int
    {
        $sql = "SELECT COUNT(*) FROM {$this->table} WHERE servicio_id = ?";
        $stmt = $this->prepareAndExecute($sql, [$servicioId]);
        return (int) $stmt->fetchColumn();
    }
